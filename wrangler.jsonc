{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-models",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }

  // NOTE: there are deliberately no `vars` and no secrets here.
  // This app is bring-your-own-key: every visitor supplies their own Cloudflare
  // Account ID + API token from the browser, and the Worker forwards them
  // per-request without ever storing or logging them.
}
